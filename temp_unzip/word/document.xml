0038260E" w:rsidRPr="007E2299" w:rsidRDefault="0038260E" w:rsidP="00775B75"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>10. Modificar o status das demandas registradas em conformidade com o que for registrado no item 1.9 deste prompt</w:t></w:r></w:p><w:p w14:paraId="52595639" w14:textId="77777777" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">11. </w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Adicione uma funcionalidade para registrar o histórico de acompanhamento de cada demanda, permitindo anotar comentários e mudanças de status conforme o trabalho avança.</w:t></w:r></w:p><w:p w14:paraId="00D2B122" w14:textId="77777777" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">12. </w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Adicione opções de filtros na lista de demandas para que eu possa localizar rapidamente todas as solicitações de uma escola específica ou de um determinado tipo de serviço.</w:t></w:r></w:p><w:p w14:paraId="21FA271A" w14:textId="4A3C188A" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>13. N</w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>a aba registro de ações das demandas, permitir que os registros das ações das demandas possam ser editados.</w:t></w:r></w:p><w:p w14:paraId="14BAD2AF" w14:textId="3B4C55A4" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">14. </w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Criar cadastros com os nomes e funções dos demandantes inseridos para facilitar o preenchimento.</w:t></w:r></w:p><w:p w14:paraId="5E314CED" w14:textId="0EE7AC23" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">15. </w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Criar planilha para o download, em formato </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>excel</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>, com os dados dos registros de demandas, com possibilidade de download dessa planilha.</w:t></w:r></w:p><w:p w14:paraId="280FDA3C" w14:textId="4BE1A68B" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">16. </w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Mudar o gráfico de “Demandas por tipo” para o modelo pizza;</w:t></w:r></w:p><w:p w14:paraId="0333F0D7" w14:textId="750B2246" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">17. </w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Organizar as abas de demandas no Dashboard em conformidade com as informações de status das demandas;</w:t></w:r></w:p><w:p w14:paraId="7AAB0EB1" w14:textId="29CBFA73" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">18. </w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Possibilitar desarquivar demandas já arquivadas;</w:t></w:r></w:p><w:p w14:paraId="0F5F8B0D" w14:textId="30482D8A" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">19. </w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Ajustar o relógio do app para o fuso horário de Manaus-Am;</w:t></w:r></w:p><w:p w14:paraId="5F6627BF" w14:textId="18E29C48" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">20. </w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Acrescentar filtro de demandas com processo no SIGED;</w:t></w:r></w:p><w:p w14:paraId="6D0FA2CD" w14:textId="70FF9485" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">21. </w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Configure o envio de notificações automáticas via Slack toda vez que o status de uma demanda for alterado, para manter a equipe da coordenadoria sempre atualizada;</w:t></w:r></w:p><w:p w14:paraId="0BE57934" w14:textId="1B155B3E" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">22. </w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Crie, como opcional, uma visualização no formato </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Kanban</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve"> para a lista de demandas, permitindo arrastar os cartões entre as colunas de status para facilitar o acompanhamento do fluxo de trabalho.</w:t></w:r></w:p><w:p w14:paraId="21901BB9" w14:textId="190F67BC" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>23</w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>. Corrigir no Dashboard:</w:t></w:r></w:p><w:p w14:paraId="30844A85" w14:textId="77777777" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/></w:pPr><w:r w:rsidRPr="007E2299"><w:t>Onde aparece “Demandas”, colocar em caixa alta, o número deve ser o total de demandas;</w:t></w:r></w:p><w:p w14:paraId="5E2BA0A3" w14:textId="77777777" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/></w:pPr><w:r w:rsidRPr="007E2299"><w:t>Onde aparece “Resolvidas”, substituir por “FINALIZADAS”, o número deve ser o mesmo de demandas com status de “FINALIZADA”;</w:t></w:r></w:p><w:p w14:paraId="4ABE82A1" w14:textId="77777777" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/></w:pPr><w:r w:rsidRPr="007E2299"><w:t>Onde aparece “Pendentes”, substituir por “EM ANDAMENTO”, o número deve ser o mesmo de demandas com status de “EM ANDAMENTO”</w:t></w:r></w:p><w:p w14:paraId="09A6262B" w14:textId="77777777" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/></w:pPr><w:r w:rsidRPr="007E2299"><w:t>Onde aparece “Arquivadas”, colocar em caixa alta, o número deve ser o mesmo de demandas com status de “ARQUIVADAS”</w:t></w:r></w:p><w:p w14:paraId="461304A1" w14:textId="05766838" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>24</w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>. Incluir as demandas “ARQUIVADAS” no gráfico de “Demandas por status”;</w:t></w:r></w:p><w:p w14:paraId="62A5797D" w14:textId="38F75E69" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>25</w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>. No gráfico “Demandas por tipo”, aumentar o espaço para organizar as legendas, o gráfico e as legendas devem estar organizados e limpos de forma legível;</w:t></w:r></w:p><w:p w14:paraId="0132AAEC" w14:textId="693716F7" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>26</w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>. Incluir a possibilidade de alterar os tipos de gráficos no Dashboard;</w:t></w:r></w:p><w:p w14:paraId="0FD3D28A" w14:textId="3F93E1A6" w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidRDefault="00BF7418" w:rsidP="00BF7418"><w:pPr><w:pStyle w:val="SemEspaamento"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>27</w:t></w:r><w:r w:rsidRPr="007E2299"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">. Adicione uma visualização de calendário que mostre as demandas agendadas por data, para que possamos visualizar melhor o cronograma de manutenção das escolas; </w:t></w:r></w:p><w:sectPr w:rsidR="00BF7418" w:rsidRPr="007E2299" w:rsidSect="00BF7418"><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="567" w:right="567" w:bottom="567" w:left="567" w:header="709" w:footer="709" w:gutter="0"/><w:cols w:space="708"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>