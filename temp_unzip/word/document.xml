99"><w:t>c) Nome da Escola Demandante;</w:t></w:r></w:p><w:p w14:paraId="1CA12651" w14:textId="7943E32D" w:rsidR="00775B75" w:rsidRPr="007E2299" w:rsidRDefault="00775B75" w:rsidP="00775B75"><w:pPr><w:pStyle w:val="SemEspaamento"/></w:pPr><w:r w:rsidRPr="007E2299"><w:t>d) Servidor responsável pelo atendimento (Nome do Funcionário da Coordenadoria com sua matrícula);</w:t></w:r></w:p><w:p w14:paraId="56B47232" w14:textId="10C25B6B" w:rsidR="00775B75" w:rsidRPr="007E2299" w:rsidRDefault="00775B75" w:rsidP="00775B75"><w:pPr><w:pStyle w:val="SemEspaamento"/></w:pPr><w:r w:rsidRPr="007E2299"><w:t xml:space="preserve">e) Tipo de Demanda (Elétrica, Hidráulica, Telhado, Forro, Poço Artesiano, Fossa </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="007E2299"><w:t xml:space="preserve">Séptica, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="007E2299"><w:t>etc</w:t></w:r><w:proofErr w:type="spellEnd"/><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="007E2299"><w:t>), tornar possível cadastrar novos tipos de demanda;</w:t></w:r></w:p><w:p w14:paraId="662AB540" w14:textId="1CF6DD9D" w:rsidR="00775B75" w:rsidRPr="007E2299" w:rsidRDefault="00775B75" w:rsidP="00775B75"><w:pPr><w:pStyle w:val="SemEspaamento"/></w:pPr><w:r w:rsidRPr="007E2299"><w:t xml:space="preserve">f) Status do Atendimento (Resolvido, Não Resolvido, </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="007E2299"><w:t>Não</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="007E2299"><w:t xml:space="preserve"> se </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="007E2299"><w:t xml:space="preserve">aplica, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="007E2299"><w:t>etc</w:t></w:r><w:proofErr w:type="spellEnd"/><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="007E2299"><w:t>), tornar possível cadastrar novos status para o atendimento da demanda;</w:t></w:r></w:p><w:p w14:paraId="55CBA92D" w14:textId="20EA99EE" w:rsidR="00775B75" w:rsidRPr="007E2299" w:rsidRDefault=